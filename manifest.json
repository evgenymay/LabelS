{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/evgenymay/LabelS",
  "icons": {
    "48": "icons/labels.svg",
    "96": "icons/labels.svg"
  },
  "permissions": [
    "history",
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://favicon.categorization.dev/*",
    "https://www.google.com/s2/favicons*"
  ],
  "optional_host_permissions": [
    "https://suggestqueries.google.com/complete/search*",
    "https://yandex.com/suggest/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "48": "icons/labels.svg"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab-personalizing@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "searchTerms"
        ],
        "optional": []
      }
    }
  }
}
