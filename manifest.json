{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "history",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://favicon.categorization.dev/*",
    "https://www.google.com/*",
    "https://*.gstatic.com/*",
    "https://suggestqueries.google.com/*",
    "https://suggest.yandex.ru/*",
    "https://yandex.ru/*",
    "https://yandex.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab-personalizing@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}